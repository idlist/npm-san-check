{
  "lineWidth": 120,
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysSingle"
  },
  "json": {
    "trailingCommas": "jsonc"
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "bin/**"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2"
  ]
}
