{
  "name": "npm-san-check",
  "version": "0.2.8",
  "description": "Simple npm update checker with fewer dependency and fewer functionalities.",
  "keywords": [
    "npm",
    "check",
    "dependency",
    "update checker",
    "updater"
  ],
  "homepage": "https://github.com/idlist/npm-san-check#readme",
  "bugs": {
    "url": "https://github.com/idlist/npm-san-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idlist/npm-san-check.git"
  },
  "license": "MIT",
  "author": "i'DLisT <i@idl.ist> (https://idl.ist/)",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "npm-san-check": "bin/cli.js",
    "npm-sc": "bin/cli.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "dev": "tsx lib/cli.ts",
    "build": "tsx build.ts",
    "build:prod": "tsc && tsx build.ts",
    "lint": "oxlint",
    "fmt": "dprint fmt"
  },
  "dependencies": {
    "kleur": "^4.1.5",
    "minimist": "^1.2.8",
    "p-ratelimit": "^1.0.1",
    "semver": "^7.8.5",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "~24.19.2",
    "@types/semver": "^7.8.0",
    "colorette": "^2.0.20",
    "dprint": "^0.64.1",
    "es-toolkit": "^1.52.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "dprint@0.64.1": true,
    "esbuild@0.28.2": true
  }
}
