    "dprint": "^0.64.1",
    "es-toolkit": "^1.52.0",
    "esbuild": "^0.28.2",
    "minimist": "^1.2.8",
    "normalize-url": "^10.0.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "verkit": "^0.5.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "dprint@0.64.1": true,
