{
  "name": "npm-san-check",
  "version": "1.0.3",
  "description": "Simple npm update checker with fewer dependency and fewer features.",
  "keywords": [
    "npm",
    "check",
    "dependency",
    "update"
  ],
  "homepage": "https://github.com/idlist/npm-san-check#readme",
  "bugs": {
    "url": "https://github.com/idlist/npm-san-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idlist/npm-san-check.git"
  },
  "license": "PolyForm-Internal-Use-1.0.0",
  "author": "i'DLisT <i@idl.ist> (https://idl.ist/)",
  "type": "module",
  "main": "bin/cli.mjs",
  "bin": {
    "npm-san-check": "bin/cli.mjs",
    "npm-sc": "bin/cli.mjs"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "once": "tsx lib/cli.ts",
    "build": "tsdown",
    "prod": "tsc && tsdown",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "dprint fmt"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "dprint": "^0.64.3",
    "es-toolkit": "^1.53.2",
    "minimist": "^1.2.8",
    "normalize-url": "^10.0.0",
    "oxlint": "^1.93.0",
    "p-queue": "^10.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "verkit": "^0.5.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "dprint@0.64.3": true
  }
}
