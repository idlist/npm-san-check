{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2024",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@src/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "temp/**/*"
  ]
}
