{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2024",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@old/*": ["./src-old/*"],
      "@src/*": ["./src/*"],
      "@declor/*": ["./src/color/*"]
    }
  },
  "include": ["src/**/*", "lib/**/*"]
}
